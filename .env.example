# Source explicitly: set -a; source .env; set +a
WORKSPACE_ROOT=..
BASE_MODEL=Qwen/Qwen3-8B
# Zero-download baseline. For semantic search install .[embeddings] and choose:
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=hashing-v1
MAX_FILE_BYTES=1000000
INCLUDE_BLAME=false
TEACHER_PROVIDER=disabled
ALLOW_EXTERNAL_TEACHER=false
TEACHER_BASE_URL=http://127.0.0.1:8000/v1
TEACHER_MODEL=Qwen/Qwen3-8B
TEACHER_API_KEY=
SEQUENCE_LEN=2048
EPOCHS=2
MICRO_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=16
LORA_R=16
LORA_ALPHA=32
LEARNING_RATE=0.0001
FLASH_ATTENTION=false
ADAPTER_PATH=
INFERENCE_4BIT=true
INFERENCE_CONTEXT_TOKENS=4096
MAX_NEW_TOKENS=512
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
AXOLOTL_DO_NOT_TRACK=1
